{
  "name": "GDAP-Manager",
  "version": "1.5.0",
  "description": "A desktop application to create Microsoft 365 GDAP requests, powered by Vite + Electron.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/ensure-electron.mjs",
    "build": "electron-vite build",
    "package:win": "npm run build && electron-builder --win",
	"prepackage:win": "node scripts/ensure-electron.mjs",
	"package:mac": "npm run build && electron-builder --mac",
	"prepackage:mac": "node scripts/ensure-electron.mjs",
	"package:linux": "npm run build && electron-builder --linux",
	"prepackage:linux": "node scripts/ensure-electron.mjs",
    "postinstall": "electron-builder install-app-deps && npm run fix:electron",
    "fix:electron": "node scripts/ensure-electron.mjs",
    "fix:electron:force": "node scripts/ensure-electron.mjs --force",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.node.check.json",
    "clean": "rimraf out release",
    "clean:full": "powershell -NoProfile -ExecutionPolicy Bypass -File Clean-Repo.ps1",
    "clean:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File Clean-Repo.ps1 -DryRun"
  },
  "author": "Jarno Kurki",
  "contributor": "Steven Rudolph",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^5.0.0",
    "@azure/msal-node-extensions": "^5.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.gdap.requestcreator",
    "productName": "GDAP Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
